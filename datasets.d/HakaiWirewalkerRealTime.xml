<dataset type="EDDTableFromDatabase" datasetID="HakaiWirewalkerRealTime" active="true">
    <sourceUrl>hakai_erddap_sourceUrl</sourceUrl>
    <driverName>org.postgresql.Driver</driverName>
    <schemaName>erddap</schemaName>
    <tableName>"HakaiWirewalkerRealTime"</tableName>
    <reloadEveryNMinutes>1440</reloadEveryNMinutes>
    <defaultGraphQuery>longitude%2Clatitude%2Ctime&amp;time&gt;=now-2days</defaultGraphQuery>
    <defaultDataQuery>&amp;time&gt;=now-2days</defaultDataQuery>
    <!-- CIOOS identity fields (id, doi, naming_authority, metadata_form, metadata_link,
         date_created/modified) are intentionally omitted: they must be populated from a
         dedicated metadata-form entry for this real-time dataset, not copied from the
         provisional DOI record. -->
    <addAttributes>
        <att name="Conventions">COARDS, CF-1.6, ACDD-1.3</att>
        <att name="institution">Hakai Institute</att>
        <att name="license">https://creativecommons.org/licenses/by/4.0</att>
        <att name="standard_name_vocabulary">CF Standard Name Table v79</att>
        <att name="cdm_data_type">TimeSeries</att>
        <att name="cdm_timeseries_variables">serial_number, latitude, longitude</att>
        <att name="subsetVariables">serial_number, latitude, longitude</att>
        <att name="title">Water Property Measurements from the Bute Inlet Ocean Observing Station (BIOOS) Wirewalker, Bute Inlet, BC, Canada (Real-Time)</att>
        <att name="summary">Bute Inlet, a prominent fjord on the British Columbia coast, has been a site for high-resolution oceanographic profiling through the Bute Inlet Ocean Observing Station (BIOOS). A Canadian Pacific Robotic Ocean Observing Facility (C-PROOF) Wirewalker wave-powered profiling instrument is deployed on a mooring in the central fjord, collecting vertical profiles of conductivity, temperature, pressure, and dissolved oxygen concentration. This real-time contribution combines the full-resolution record offloaded from the instrument with the radio-transmitted telemetry that extends it to the present. It is raw and has not undergone quality control; for processed, cast-grouped profiles see the HakaiWirewalkerProvisional dataset.</att>
        <att name="infoUrl">https://www.hakai.org/</att>
        <att name="sourceUrl">(local database)</att>
        <att name="geospatial_lat_max">50.5744</att>
        <att name="geospatial_lat_min">50.5744</att>
        <att name="geospatial_lon_max">-124.9009</att>
        <att name="geospatial_lon_min">-124.9009</att>
        <att name="project">Oceanography</att>
        <att name="keywords">oceans,bute-inlet,homalco-territory,salish-sea,marine-productivity,oceanography,water temperature,salinity,wirewalker,CIOOS:subSurfaceTemperature,CIOOS:subSurfaceSalinity,CIOOS:oxygen,CIOOS:phytoplanktonBiomassAndDiversity</att>
        <att name="keywords_vocabulary">CIOOS: CIOOS Essential Ocean Variables Vocabulary</att>
        <att name="creator_name">Hakai Institute</att>
        <att name="creator_type">institution</att>
        <att name="creator_institution">Hakai Institute</att>
        <att name="creator_url">https://www.hakai.org/</att>
        <att name="publisher_name">Hakai Institute</att>
        <att name="publisher_type">institution</att>
        <att name="publisher_institution">Hakai Institute</att>
        <att name="publisher_url">https://www.hakai.org/</att>
        <att name="publisher_email">data@hakai.org</att>
        <att name="platform">moored surface buoy</att>
        <att name="platform_vocabulary">http://vocab.nerc.ac.uk/collection/L06/current/</att>
    </addAttributes>
    <dataVariable>
        <sourceName>serial_number</sourceName>
        <destinationName>serial_number</destinationName>
        <dataType>long</dataType>
        <addAttributes>
            <att name="long_name">Serial Number</att>
            <att name="cf_role">timeseries_id</att>
            <att name="ioos_category">Identifier</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>=50.5744</sourceName>
        <destinationName>latitude</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="long_name">Latitude</att>
            <att name="standard_name">latitude</att>
            <att name="units">degrees_north</att>
            <att name="description">Fixed latitude of the deployment site</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>=-124.9009</sourceName>
        <destinationName>longitude</destinationName>
        <dataType>float</dataType>
        <addAttributes>
            <att name="long_name">Longitude</att>
            <att name="standard_name">longitude</att>
            <att name="units">degrees_east</att>
            <att name="description">Fixed longitude of the deployment site</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>measurement_dt</sourceName>
        <destinationName>time</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="ioos_category">Time</att>
            <att name="long_name">Time</att>
            <att name="standard_name">time</att>
            <att name="units">seconds since 1970-01-01T00:00:00Z</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>pk</sourceName>
        <destinationName>pk</destinationName>
        <dataType>long</dataType>
        <addAttributes>
            <att name="long_name">Primary Key</att>
            <att name="ioos_category">Identifier</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>conductivity</sourceName>
        <destinationName>conductivity</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Conductivity</att>
            <att name="standard_name">sea_water_electrical_conductivity</att>
            <att name="units">mS/cm</att>
            <att name="ioos_category">Salinity</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>temperature</sourceName>
        <destinationName>temperature</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Temperature</att>
            <att name="standard_name">sea_water_temperature</att>
            <att name="units">degree_Celsius</att>
            <att name="ioos_category">Temperature</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>pressure</sourceName>
        <destinationName>pressure</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Pressure</att>
            <att name="standard_name">sea_water_pressure</att>
            <att name="units">dbar</att>
            <att name="ioos_category">Pressure</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>temperature_1</sourceName>
        <destinationName>temperature_1</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Temperature 1</att>
            <att name="standard_name">sea_water_temperature</att>
            <att name="units">degree_Celsius</att>
            <att name="ioos_category">Temperature</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>dissolved_oxygen_ml_l</sourceName>
        <destinationName>dissolved_o2</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Dissolved Oxygen Concentration</att>
            <att name="standard_name">volume_fraction_of_oxygen_in_sea_water</att>
            <att name="units">mL/L</att>
            <att name="ioos_category">Dissolved O2</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>backscatter_counts</sourceName>
        <destinationName>backscatter_counts</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Backscatter Counts</att>
            <att name="units">counts</att>
            <att name="ioos_category">Optical Properties</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>chlorophyll_counts</sourceName>
        <destinationName>chlorophyll_counts</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Chlorophyll Counts</att>
            <att name="units">counts</att>
            <att name="ioos_category">Optical Properties</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>cdom_counts</sourceName>
        <destinationName>cdom_counts</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">CDOM Counts</att>
            <att name="units">counts</att>
            <att name="ioos_category">Optical Properties</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>cast_id</sourceName>
        <destinationName>cast_id</destinationName>
        <dataType>long</dataType>
        <addAttributes>
            <att name="long_name">Cast ID</att>
            <att name="ioos_category">Identifier</att>
            <att name="comment">Present only for radio-transmitted rows; null for the offloaded full-resolution record. A radio cast counter resets per deployment, so identify a profile by (serial_number, cast_id).</att>
        </addAttributes>
    </dataVariable>
</dataset>
